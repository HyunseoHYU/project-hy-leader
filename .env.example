# Copy this file to .env and fill in real credentials. Never commit .env.

# X (Twitter) API v2 - developer.twitter.com
X_BEARER_TOKEN=

# Reddit API - reddit.com/prefs/apps (create a "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=hy-leader-sentiment-collector/0.1 by <your_reddit_username>

# CryptoPanic API - cryptopanic.com/developers/api
CRYPTOPANIC_API_KEY=

# NewsAPI - newsapi.org
NEWSAPI_KEY=

# Real-time order-book collector (collectors/collect_orderbook_ws.py)
# No exchange credentials needed - Binance market-data streams are public.
# SOURCE_HOST labels which independent collector instance wrote a given file
# (e.g. "vps" or "local") so the two redundant trees never collide and can be merged.
SOURCE_HOST=local
ORDERBOOK_SYMBOLS=btcusdt
FLUSH_INTERVAL_SEC=20
